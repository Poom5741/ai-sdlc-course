---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';

export interface Props {
  title: string;
  description?: string;
  sidebar?: boolean;
  headings?: { depth: number; slug: string; text: string }[];
  prev?: { label: string; url: string };
  next?: { label: string; url: string };
}

const { title, description, sidebar = false, headings = [], prev, next } = Astro.props;
const currentPath = Astro.url.pathname;

const navigation = [
  {
    title: 'Overview',
    url: '/workshop/overview'
  },
  {
    title: 'Block 1: AI Tools',
    url: '/workshop/block-1-ai-tools',
    items: [
      { title: 'Overview', url: '/workshop/block-1-ai-tools' },
      { title: 'Quest 1.1: First Completion', url: '/quests/quest-1-first-code' },
      { title: 'Quest 1.2: Multi-file', url: '/quests/quest-2-prompts' },
      { title: 'Quest 1.3: Compare Tools', url: '/quests/quest-3-security' }
    ]
  },
  {
    title: 'Block 2: Prompting',
    url: '/workshop/block-2-prompting',
    items: [
      { title: 'Overview', url: '/workshop/block-2-prompting' },
      { title: 'Quest 2.1: Fix Prompt', url: '/quests/quest-4-loops' },
      { title: 'Quest 2.2: Multi-Step', url: '/quests/quest-5-project' }
    ]
  },
  {
    title: 'Block 3: Security',
    url: '/workshop/block-3-security',
    items: [
      { title: 'Overview', url: '/workshop/block-3-security' }
    ]
  },
  {
    title: 'Block 4: Loops',
    url: '/workshop/block-4-loops',
    items: [
      { title: 'Overview', url: '/workshop/block-4-loops' }
    ]
  },
  {
    title: 'Block 5: Architecture',
    url: '/workshop/block-5-architecture',
    items: [
      { title: 'Overview', url: '/workshop/block-5-architecture' }
    ]
  },
  {
    title: 'Reference',
    url: '/reference/github-copilot',
    items: [
      { title: 'GitHub Copilot', url: '/reference/github-copilot' }
    ]
  }
];
---

<BaseLayout title={title} description={description}>
  <div class="flex min-h-screen pt-16">
    {sidebar && <Sidebar sections={navigation} currentPath={currentPath} />}
    
    <main class:list={["flex-1 px-6 py-12", sidebar ? "md:ml-64" : "max-w-4xl mx-auto"]}>
      <div class="flex gap-8">
        <article class="prose prose-invert max-w-none flex-1 min-w-0">
          <slot />
        </article>
        <TableOfContents headings={headings} />
      </div>
      
      {(prev || next) && (
        <nav class="flex justify-between mt-12 pt-6 border-t border-gray-800">
          {prev ? (
            <a href={prev.url} class="text-blue-400 hover:text-blue-300">
              ← {prev.label}
            </a>
          ) : <span />}
          {next ? (
            <a href={next.url} class="text-blue-400 hover:text-blue-300">
              {next.label} →
            </a>
          ) : <span />}
        </nav>
      )}
    </main>
  </div>
</BaseLayout>
