---
export interface Props {
  title: string;
  icon?: string;
}

const { title, icon } = Astro.props;
---

<div class="bg-[#1a1a2e] border border-gray-800 rounded-lg p-4 hover:border-blue-600 transition-colors">
  <h3 class="text-lg font-semibold text-white mb-2">
    {icon && <span class="mr-2">{icon}</span>}
    {title}
  </h3>
  <div class="text-gray-300 text-sm">
    <slot />
  </div>
</div>
