---
export interface NavItem {
  title: string;
  url: string;
  items?: NavItem[];
}

export interface Props {
  sections: NavItem[];
  currentPath: string;
}

const { sections, currentPath } = Astro.props;
---

<aside id="sidebar" class="w-64 bg-[#0a0a1a] border-r border-gray-800 hidden md:block fixed top-20 bottom-0 left-0 overflow-y-auto">
  <nav class="p-4 space-y-1">
    {sections.map(section => (
      <div class="sidebar-section">
        {section.items ? (
          <div class="sidebar-group">
            <button
              class="sidebar-toggle w-full flex items-center justify-between px-3 py-2 text-sm font-medium text-gray-300 hover:text-white hover:bg-gray-800/50 rounded transition-colors"
              data-section={section.url}
            >
              <span class="flex items-center gap-2">
                <span class="progress-check" data-url={section.url}></span>
                {section.title}
              </span>
              <svg class="w-4 h-4 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </button>
            <div class="sidebar-items ml-4 space-y-0.5" data-parent={section.url}>
              {section.items.map(item => (
                <a
                  href={item.url}
                  data-nav-url={item.url}
                  class:list={[
                    "sidebar-link block px-3 py-1.5 text-sm rounded transition-colors",
                    currentPath === item.url
                      ? "text-blue-400 bg-blue-500/10 border-l-2 border-blue-400 -ml-[2px]"
                      : "text-gray-400 hover:text-white hover:bg-gray-800/50"
                  ]}
                >
                  <span class="flex items-center gap-2">
                    <span class="progress-check" data-url={item.url}></span>
                    {item.title}
                  </span>
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={section.url}
            data-nav-url={section.url}
            class:list={[
              "sidebar-link block px-3 py-2 text-sm font-medium rounded transition-colors",
              currentPath === section.url
                ? "text-blue-400 bg-blue-500/10 border-l-2 border-blue-400 -ml-[2px]"
                : "text-gray-400 hover:text-white hover:bg-gray-800/50"
            ]}
          >
            <span class="flex items-center gap-2">
              <span class="progress-check" data-url={section.url}></span>
              {section.title}
            </span>
          </a>
        )}
      </div>
    ))}
  </nav>
</aside>

<!-- Mobile hamburger button -->
<button
  id="mobile-menu-btn"
  class="md:hidden fixed top-4 left-4 z-50 p-2 bg-gray-900 border border-gray-700 rounded"
  aria-label="Toggle menu"
>
  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
  </svg>
</button>

<!-- Mobile sidebar overlay -->
<div id="mobile-sidebar-overlay" class="md:hidden fixed inset-0 bg-black/50 z-40 hidden"></div>

<!-- Mobile sidebar -->
<aside id="mobile-sidebar" class="md:hidden fixed top-0 left-0 w-64 h-full bg-[#0a0a1a] border-r border-gray-800 z-50 transform -translate-x-full transition-transform">
  <div class="p-4 border-b border-gray-800 flex items-center justify-between">
    <span class="text-white font-medium">Menu</span>
    <button id="close-sidebar" class="text-gray-400 hover:text-white">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <nav class="p-4 space-y-1">
    {sections.map(section => (
      <div class="sidebar-section">
        {section.items ? (
          <div class="sidebar-group">
            <button
              class="sidebar-toggle w-full flex items-center justify-between px-3 py-2 text-sm font-medium text-gray-300 hover:text-white hover:bg-gray-800/50 rounded transition-colors"
              data-section={section.url}
            >
              <span class="flex items-center gap-2">
                <span class="progress-check" data-url={section.url}></span>
                {section.title}
              </span>
              <svg class="w-4 h-4 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </button>
            <div class="sidebar-items ml-4 space-y-0.5" data-parent={section.url}>
              {section.items.map(item => (
                <a
                  href={item.url}
                  data-nav-url={item.url}
                  class:list={[
                    "sidebar-link block px-3 py-1.5 text-sm rounded transition-colors",
                    currentPath === item.url
                      ? "text-blue-400 bg-blue-500/10 border-l-2 border-blue-400 -ml-[2px]"
                      : "text-gray-400 hover:text-white hover:bg-gray-800/50"
                  ]}
                >
                  <span class="flex items-center gap-2">
                    <span class="progress-check" data-url={item.url}></span>
                    {item.title}
                  </span>
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={section.url}
            data-nav-url={section.url}
            class:list={[
              "sidebar-link block px-3 py-2 text-sm font-medium rounded transition-colors",
              currentPath === section.url
                ? "text-blue-400 bg-blue-500/10 border-l-2 border-blue-400 -ml-[2px]"
                : "text-gray-400 hover:text-white hover:bg-gray-800/50"
            ]}
          >
            <span class="flex items-center gap-2">
              <span class="progress-check" data-url={section.url}></span>
              {section.title}
            </span>
          </a>
        )}
      </div>
    ))}
  </nav>
</aside>

<script>
  // Progress tracking with localStorage
  const STORAGE_KEY = 'workshop-visited-pages';

  function getVisitedPages(): string[] {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
    } catch {
      return [];
    }
  }

  function markPageVisited(url: string) {
    const visited = getVisitedPages();
    if (!visited.includes(url)) {
      visited.push(url);
      localStorage.setItem(STORAGE_KEY, JSON.stringify(visited));
    }
  }

  function updateProgressUI() {
    const visited = getVisitedPages();
    document.querySelectorAll('.progress-check').forEach(el => {
      const url = el.getAttribute('data-url');
      if (url && visited.includes(url)) {
        el.innerHTML = '<svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>';
      }
    });
  }

  // Mark current page as visited
  markPageVisited(window.location.pathname);
  updateProgressUI();

  // Toggle sidebar sections
  document.querySelectorAll('.sidebar-toggle').forEach(button => {
    button.addEventListener('click', () => {
      const section = button.getAttribute('data-section');
      const items = document.querySelector(`[data-parent="${section}"]`);
      const icon = button.querySelector('svg:last-child');
      
      if (items) {
        items.classList.toggle('hidden');
        icon?.classList.toggle('rotate-90');
      }
    });
  });

  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const sidebar = document.getElementById('mobile-sidebar');
  const overlay = document.getElementById('mobile-sidebar-overlay');
  const closeBtn = document.getElementById('close-sidebar');

  function openMenu() {
    sidebar?.classList.remove('-translate-x-full');
    overlay?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    sidebar?.classList.add('-translate-x-full');
    overlay?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  menuBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);

  // Auto-expand current section
  document.querySelectorAll('.sidebar-items').forEach(items => {
    const hasActive = items.querySelector('.border-l-2');
    if (hasActive) {
      items.classList.remove('hidden');
      const toggle = items.previousElementSibling?.querySelector('svg:last-child');
      toggle?.classList.add('rotate-90');
    }
  });
</script>

<style>
  .sidebar-items {
    transition: max-height 0.2s ease-out;
  }
</style>
