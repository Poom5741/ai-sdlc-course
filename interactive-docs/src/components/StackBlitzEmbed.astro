---
interface Props {
  repo: string;
  file: string;
  branch?: string;
  height?: string;
  view?: 'preview' | 'editor' | 'split';
}

const {
  repo,
  file,
  branch = 'main',
  height = '500px',
  view = 'split',
} = Astro.props;

const src = `https://stackblitz.com/edit/${repo}?embed=1&file=${file}&branch=${branch}&view=${view}`;
---

<iframe
  src={src}
  style={`width:100%;height:${height};border:0;border-radius:4px;`}
  allow="cross-origin-isolation"
  title={`StackBlitz: ${repo}/${file}`}
/>
