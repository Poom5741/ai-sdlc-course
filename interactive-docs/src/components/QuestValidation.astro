---
interface ValidationResult {
  questId: string;
  score: number;
  passed: boolean;
  feedback: string;
}

interface Props {
  questId: string;
  onComplete?: (result: ValidationResult) => void;
}

const { questId, onComplete } = Astro.props;
---

<div class="quest-validation" data-quest-id={questId}>
  <div class="validation-status">
    <span class="status-indicator">○</span>
    <span class="status-text">Not started</span>
  </div>
  
  <div class="validation-actions">
    <button class="submit-btn" data-action="submit">Submit Solution</button>
    <button class="check-btn" data-action="check">Check Progress</button>
  </div>
  
  <div class="validation-result" hidden>
    <div class="score">Score: <span class="score-value">0</span>%</div>
    <div class="feedback"></div>
  </div>
</div>

<style>
  .quest-validation {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    padding: 1rem;
    margin: 1rem 0;
  }
  
  .validation-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  
  .status-indicator {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--sl-color-gray-6);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .validation-actions {
    display: flex;
    gap: 0.5rem;
  }
  
  .submit-btn, .check-btn {
    padding: 0.5rem 1rem;
    border-radius: 4px;
    border: none;
    cursor: pointer;
  }
  
  .submit-btn {
    background: var(--sl-color-green-high);
    color: white;
  }
  
  .check-btn {
    background: var(--sl-color-gray-5);
    color: white;
  }
  
  .validation-result {
    margin-top: 1rem;
    padding: 1rem;
    background: var(--sl-color-gray-6);
    border-radius: 4px;
  }
  
  .score {
    font-size: 1.25rem;
    font-weight: bold;
  }
</style>

<script>
  document.querySelectorAll('.quest-validation').forEach(el => {
    const questId = el.dataset.questId;
    const submitBtn = el.querySelector('[data-action="submit"]');
    const checkBtn = el.querySelector('[data-action="check"]');
    const resultDiv = el.querySelector('.validation-result');
    const scoreValue = el.querySelector('.score-value');
    const feedback = el.querySelector('.feedback');
    
    submitBtn?.addEventListener('click', () => {
      // Simulate validation
      const score = Math.floor(Math.random() * 40) + 60; // 60-100
      scoreValue.textContent = score.toString();
      feedback.textContent = score >= 80 
        ? 'Great job! Your solution is correct.'
        : 'Good attempt. Review the requirements and try again.';
      resultDiv.hidden = false;
    });
    
    checkBtn?.addEventListener('click', () => {
      alert('Progress checked! Keep going!');
    });
  });
</script>
