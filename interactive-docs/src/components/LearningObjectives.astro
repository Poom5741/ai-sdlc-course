---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<div class="learning-objectives">
  <h3>🎯 Learning Objectives</h3>
  <ul>
    {items.map(item => (
      <li>
        <span class="check-icon">✅</span>
        <span>{item}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .learning-objectives {
    border: 1px solid var(--sl-color-accent-high);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    background: linear-gradient(135deg, rgba(79, 43, 223, 0.1), rgba(0, 200, 100, 0.05));
  }
  
  .learning-objectives h3 {
    margin-top: 0;
    margin-bottom: 0.75rem;
    color: var(--sl-color-accent-high);
  }
  
  .learning-objectives ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .learning-objectives li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    color: var(--sl-color-gray-1);
    line-height: 1.5;
  }
  
  .learning-objectives li:last-child {
    margin-bottom: 0;
  }
  
  .check-icon {
    flex-shrink: 0;
    line-height: 1.5;
  }
</style>
