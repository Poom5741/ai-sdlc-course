---
// TOC is rendered client-side from DOM headings
---

<aside id="toc-container" class="hidden xl:block w-56 shrink-0">
  <nav class="toc sticky top-24">
    <h4 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">On this page</h4>
    <ul id="toc-list" class="space-y-1.5">
      <!-- Populated by client-side script -->
    </ul>
  </nav>
</aside>

<script>
  // Build TOC from DOM headings
  function buildTOC() {
    const article = document.querySelector('article.prose');
    const tocList = document.getElementById('toc-list');
    if (!article || !tocList) return;

    const headings = article.querySelectorAll('h2[id], h3[id]');
    headings.forEach(heading => {
      const li = document.createElement('li');
      if (heading.tagName === 'H3') li.classList.add('ml-3');
      
      const a = document.createElement('a');
      a.href = `#${heading.id}`;
      a.className = 'toc-link block text-sm text-gray-500 hover:text-gray-300 transition-colors py-0.5';
      a.dataset.heading = heading.id;
      a.textContent = heading.textContent;
      
      li.appendChild(a);
      tocList.appendChild(li);
    });

    // Scroll spy
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            document.querySelectorAll('.toc-link').forEach(link => {
              link.classList.remove('text-blue-400', 'font-medium');
              link.classList.add('text-gray-500');
            });
            const activeLink = document.querySelector(`.toc-link[data-heading="${id}"]`);
            if (activeLink) {
              activeLink.classList.add('text-blue-400', 'font-medium');
              activeLink.classList.remove('text-gray-500');
            }
          }
        });
      },
      { rootMargin: '-80px 0px -80% 0px', threshold: 0 }
    );

    headings.forEach(heading => observer.observe(heading));
  }

  // Run on page load and after view transitions
  buildTOC();
  document.addEventListener('astro:page-load', buildTOC);
</script>
