---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="BlueBeltDojo | Master AI-Powered Software Development">
  <!-- Header -->
  <header class="fixed top-0 w-full z-50 bg-[#FAFAF9]/90 backdrop-blur-md border-b border-[#E7E5E4]">
    <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
      <a href="/" class="font-['DM_Sans'] text-xl tracking-widest uppercase text-[#1C1917]">BlueBeltDojo</a>
      <nav class="hidden md:flex items-center gap-8">
        <a class="text-sm uppercase tracking-wider text-[#78716C] hover:text-[#1C1917] transition-colors" href="#curriculum">Curriculum</a>
        <a class="text-sm uppercase tracking-wider text-[#78716C] hover:text-[#1C1917] transition-colors" href="#belts">Belts</a>
        <a class="text-sm uppercase tracking-wider text-[#78716C] hover:text-[#1C1917] transition-colors" href="#faq">FAQ</a>
        <a class="text-sm uppercase tracking-wider text-[#78716C] hover:text-[#1C1917] transition-colors" href="/community">Community</a>
      </nav>
      <div class="flex items-center gap-4">
        <a href="/login" class="text-sm text-[#78716C] hover:text-[#1C1917]">Sign In</a>
        <a href="/login" class="bg-[#059669] text-white px-6 py-2 font-['DM_Sans'] text-sm uppercase tracking-wider rounded hover:bg-[#047857] transition-colors">
          Sign In
        </a>
      </div>
    </div>
  </header>

  <main class="pt-20">
    <!-- HERO -->
    <section class="min-h-[90vh] flex items-center bg-[#FAFAF9]">
      <div class="max-w-6xl mx-auto px-6 py-24">
        <div class="max-w-3xl">
          <span class="text-sm uppercase tracking-[0.3em] text-[#D97706] mb-6 block">AI-Powered Software Development</span>
          <h1 class="font-['DM_Serif_Display'] text-6xl md:text-7xl text-[#1C1917] leading-tight mb-8">
            Master AI Coding<br/>
            <span class="text-[#059669]">Like a Black Belt</span>
          </h1>
          <p class="text-xl text-[#78716C] mb-10 max-w-2xl">
            129 hands-on quests. 3 capstone projects. A belt progression system that takes you from vibe coder to AI-powered engineer.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/login" class="bg-[#059669] text-white px-10 py-4 font-['DM_Sans'] font-bold uppercase tracking-wider rounded hover:bg-[#047857] transition-colors text-lg">
              Start Training
            </a>
            <a href="#curriculum" class="border border-[#E7E5E4] text-[#1C1917] px-10 py-4 font-['DM_Sans'] uppercase tracking-wider rounded hover:border-[#1C1917] transition-colors">
              View Curriculum
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="bg-white border-y border-[#E7E5E4] py-12">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div>
            <p class="font-['DM_Serif_Display'] text-4xl text-[#1C1917]">129</p>
            <p class="text-sm text-[#78716C] uppercase tracking-wider">Quests</p>
          </div>
          <div>
            <p class="font-['DM_Serif_Display'] text-4xl text-[#1C1917]">10</p>
            <p class="text-sm text-[#78716C] uppercase tracking-wider">Modules</p>
          </div>
          <div>
            <p class="font-['DM_Serif_Display'] text-4xl text-[#1C1917]">3</p>
            <p class="text-sm text-[#78716C] uppercase tracking-wider">Capstones</p>
          </div>
          <div>
            <p class="font-['DM_Serif_Display'] text-4xl text-[#1C1917]">5</p>
            <p class="text-sm text-[#78716C] uppercase tracking-wider">Belts</p>
          </div>
        </div>
      </div>
    </section>

    <!-- BEFORE/AFTER -->
    <section class="py-24 bg-[#FAFAF9]">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16">
          <span class="text-sm uppercase tracking-[0.3em] text-[#D97706] mb-4 block">The Problem</span>
          <h2 class="font-['DM_Serif_Display'] text-4xl text-[#1C1917]">Stop Vibe Coding.<br/>Start Engineering.</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white border border-[#E7E5E4] p-8 rounded-lg">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-2xl">😰</span>
              <h3 class="font-['DM_Sans'] font-bold text-[#DC2626] uppercase tracking-wider">Vibe Coding</h3>
            </div>
            <ul class="space-y-3 text-[#78716C]">
              <li class="flex items-start gap-2">
                <span class="text-[#DC2626]">✕</span>
                <span>Copy-pasting AI output without understanding</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#DC2626]">✕</span>
                <span>SQL injections in production code</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#DC2626]">✕</span>
                <span>No tests, no security, no monitoring</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#DC2626]">✕</span>
                <span>Hoping nothing breaks</span>
              </li>
            </ul>
          </div>
          <div class="bg-white border border-[#059669] p-8 rounded-lg">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-2xl">💪</span>
              <h3 class="font-['DM_Sans'] font-bold text-[#059669] uppercase tracking-wider">AI Engineering</h3>
            </div>
            <ul class="space-y-3 text-[#78716C]">
              <li class="flex items-start gap-2">
                <span class="text-[#059669]">✓</span>
                <span>Understand and command AI tools effectively</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#059669]">✓</span>
                <span>Security-first development practices</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#059669]">✓</span>
                <span>Tested, monitored, production-ready code</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#059669]">✓</span>
                <span>Confident, repeatable engineering</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- CURRICULUM -->
    <section id="curriculum" class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16">
          <span class="text-sm uppercase tracking-[0.3em] text-[#D97706] mb-4 block">The Curriculum</span>
          <h2 class="font-['DM_Serif_Display'] text-4xl text-[#1C1917] mb-4">10 Modules. 129 Quests.</h2>
          <p class="text-[#78716C] max-w-2xl mx-auto">
            A comprehensive journey from AI fundamentals to production-ready systems.
          </p>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-[#FAFAF9] border border-[#E7E5E4] p-6 rounded-lg">
            <span class="text-sm text-[#D97706] font-bold">Module 1</span>
            <h3 class="font-['DM_Sans'] font-bold text-[#1C1917] mb-2">Foundations of AI & LLM Technology</h3>
            <p class="text-sm text-[#78716C]">12 quests • AI tools, transformers, model architectures</p>
          </div>
          <div class="bg-[#FAFAF9] border border-[#E7E5E4] p-6 rounded-lg">
            <span class="text-sm text-[#D97706] font-bold">Module 2</span>
            <h3 class="font-['DM_Sans'] font-bold text-[#1C1917] mb-2">LLM Training & Capabilities</h3>
            <p class="text-sm text-[#78716C]">10 quests • Training, fine-tuning, RAG, embeddings</p>
          </div>
          <div class="bg-[#FAFAF9] border border-[#E7E5E4] p-6 rounded-lg">
            <span class="text-sm text-[#D97706] font-bold">Module 3</span>
            <h3 class="font-['DM_Sans'] font-bold text-[#1C1917] mb-2">AI Tools for Each SDLC Phase</h3>
            <p class="text-sm text-[#78716C]">20 quests • Planning, development, testing with AI</p>
          </div>
          <div class="bg-[#FAFAF9] border border-[#E7E5E4] p-6 rounded-lg">
            <span class="text-sm text-[#D97706] font-bold">Module 4</span>
            <h3 class="font-['DM_Sans'] font-bold text-[#1C1917] mb-2">Security, Governance & Deployment</h3>
            <p class="text-sm text-[#78716C]">20 quests • Security, compliance, DevOps</p>
          </div>
          <div class="bg-[#FAFAF9] border border-[#E7E5E4] p-6 rounded-lg">
            <span class="text-sm text-[#D97706] font-bold">Module 5</span>
            <h3 class="font-['DM_Sans'] font-bold text-[#1C1917] mb-2">Advanced AI Patterns</h3>
            <p class="text-sm text-[#78716C]">10 quests • Agentic workflows, production patterns</p>
          </div>
          <div class="bg-[#FAFAF9] border border-[#E7E5E4] p-6 rounded-lg">
            <span class="text-sm text-[#D97706] font-bold">Module 6</span>
            <h3 class="font-['DM_Sans'] font-bold text-[#1C1917] mb-2">Prompt Engineering Deep Dive</h3>
            <p class="text-sm text-[#78716C]">10 quests • Advanced prompting techniques</p>
          </div>
          <div class="bg-[#FAFAF9] border border-[#E7E5E4] p-6 rounded-lg">
            <span class="text-sm text-[#D97706] font-bold">Module 7</span>
            <h3 class="font-['DM_Sans'] font-bold text-[#1C1917] mb-2">Code Review & Documentation</h3>
            <p class="text-sm text-[#78716C]">10 quests • AI-assisted review and docs</p>
          </div>
          <div class="bg-[#FAFAF9] border border-[#E7E5E4] p-6 rounded-lg">
            <span class="text-sm text-[#D97706] font-bold">Module 8</span>
            <h3 class="font-['DM_Sans'] font-bold text-[#1C1917] mb-2">Refactoring & Migration</h3>
            <p class="text-sm text-[#78716C]">10 quests • Modernization with AI</p>
          </div>
          <div class="bg-[#FAFAF9] border border-[#E7E5E4] p-6 rounded-lg">
            <span class="text-sm text-[#D97706] font-bold">Module 9</span>
            <h3 class="font-['DM_Sans'] font-bold text-[#1C1917] mb-2">Ethics, Accessibility & Multimodal</h3>
            <p class="text-sm text-[#78716C]">8 quests • Responsible AI, multimodal systems</p>
          </div>
          <div class="bg-[#FAFAF9] border border-[#E7E5E4] p-6 rounded-lg">
            <span class="text-sm text-[#D97706] font-bold">Module 10</span>
            <h3 class="font-['DM_Sans'] font-bold text-[#1C1917] mb-2">Integration & Real-World</h3>
            <p class="text-sm text-[#78716C]">8 quests • Full SDLC, case studies</p>
          </div>
        </div>
      </div>
    </section>

    <!-- BELT PROGRESSION -->
    <section id="belts" class="py-24 bg-[#1C1917] text-white">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16">
          <span class="text-sm uppercase tracking-[0.3em] text-[#D97706] mb-4 block">The Journey</span>
          <h2 class="font-['DM_Serif_Display'] text-4xl mb-4">Earn Your Belt</h2>
          <p class="text-[#A8A29E] max-w-2xl mx-auto">
            Progress through the ranks as you complete quests and capstones.
          </p>
        </div>
        <div class="flex flex-col md:flex-row items-center justify-center gap-4 md:gap-0">
          <div class="flex flex-col items-center p-4">
            <div class="w-16 h-16 rounded-full bg-white mb-3"></div>
            <p class="font-bold">White</p>
            <p class="text-sm text-[#A8A29E]">Start here</p>
          </div>
          <div class="hidden md:block w-12 h-1 bg-[#44403C]"></div>
          <div class="flex flex-col items-center p-4">
            <div class="w-16 h-16 rounded-full bg-[#2563EB] mb-3"></div>
            <p class="font-bold">Blue</p>
            <p class="text-sm text-[#A8A29E]">20 quests + Capstone 1</p>
          </div>
          <div class="hidden md:block w-12 h-1 bg-[#44403C]"></div>
          <div class="flex flex-col items-center p-4">
            <div class="w-16 h-16 rounded-full bg-[#9333EA] mb-3"></div>
            <p class="font-bold">Purple</p>
            <p class="text-sm text-[#A8A29E]">50 quests + Capstone 2</p>
          </div>
          <div class="hidden md:block w-12 h-1 bg-[#44403C]"></div>
          <div class="flex flex-col items-center p-4">
            <div class="w-16 h-16 rounded-full bg-[#92400E] mb-3"></div>
            <p class="font-bold">Brown</p>
            <p class="text-sm text-[#A8A29E]">90 quests + Capstone 3</p>
          </div>
          <div class="hidden md:block w-12 h-1 bg-[#44403C]"></div>
          <div class="flex flex-col items-center p-4">
            <div class="w-16 h-16 rounded-full bg-[#F5F5F4] mb-3"></div>
            <p class="font-bold">Black</p>
            <p class="text-sm text-[#A8A29E]">118 quests</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CAPSTONES -->
    <section class="py-24 bg-[#FAFAF9]">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16">
          <span class="text-sm uppercase tracking-[0.3em] text-[#D97706] mb-4 block">Capstone Projects</span>
          <h2 class="font-['DM_Serif_Display'] text-4xl text-[#1C1917] mb-4">What You'll Build</h2>
          <p class="text-[#78716C] max-w-2xl mx-auto">
            Real projects that demonstrate real skills. Not toy examples.
          </p>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-white border border-[#E7E5E4] p-8 rounded-lg">
            <div class="text-sm text-[#D97706] font-bold mb-2">Capstone 1</div>
            <h3 class="font-['DM_Serif_Display'] text-2xl text-[#1C1917] mb-4">AI-Assisted API Service</h3>
            <p class="text-[#78716C] text-sm mb-4">
              Build a complete REST API from requirements to deployment using AI tools throughout the SDLC.
            </p>
            <p class="text-xs text-[#A8A29E] uppercase tracking-wider">White → Blue Belt</p>
          </div>
          <div class="bg-white border border-[#E7E5E4] p-8 rounded-lg">
            <div class="text-sm text-[#D97706] font-bold mb-2">Capstone 2</div>
            <h3 class="font-['DM_Serif_Display'] text-2xl text-[#1C1917] mb-4">Multi-Agent System</h3>
            <p class="text-[#78716C] text-sm mb-4">
              Design and build a system of collaborating AI agents with tool integration and observability.
            </p>
            <p class="text-xs text-[#A8A29E] uppercase tracking-wider">Blue → Purple Belt</p>
          </div>
          <div class="bg-white border border-[#E7E5E4] p-8 rounded-lg">
            <div class="text-sm text-[#D97706] font-bold mb-2">Capstone 3</div>
            <h3 class="font-['DM_Serif_Display'] text-2xl text-[#1C1917] mb-4">Production AI App</h3>
            <p class="text-[#78716C] text-sm mb-4">
              Ship a real AI-powered application with monitoring, cost management, and security.
            </p>
            <p class="text-xs text-[#A8A29E] uppercase tracking-wider">Purple → Brown Belt</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="py-24 bg-white">
      <div class="max-w-3xl mx-auto px-6">
        <div class="text-center mb-16">
          <span class="text-sm uppercase tracking-[0.3em] text-[#D97706] mb-4 block">FAQ</span>
          <h2 class="font-['DM_Serif_Display'] text-4xl text-[#1C1917]">Questions & Answers</h2>
        </div>
        <div class="space-y-6">
          <div class="border-b border-[#E7E5E4] pb-6">
            <h3 class="font-['DM_Sans'] font-bold text-[#1C1917] mb-2">Do I need coding experience?</h3>
            <p class="text-[#78716C]">Basic programming knowledge helps, but the course teaches you how to leverage AI tools effectively. Start with the free preview to gauge the level.</p>
          </div>
          <div class="border-b border-[#E7E5E4] pb-6">
            <h3 class="font-['DM_Sans'] font-bold text-[#1C1917] mb-2">How long does it take?</h3>
            <p class="text-[#78716C]">Most learners complete the course in 4-8 weeks, spending a few hours per day. The belt system lets you progress at your own pace.</p>
          </div>
          <div class="border-b border-[#E7E5E4] pb-6">
            <h3 class="font-['DM_Sans'] font-bold text-[#1C1917] mb-2">What tools do I need?</h3>
            <p class="text-[#78716C]">A laptop with VS Code and access to AI tools like GitHub Copilot or Claude. We help you set everything up in Module 1.</p>
          </div>
          <div class="border-b border-[#E7E5E4] pb-6">
            <h3 class="font-['DM_Sans'] font-bold text-[#1C1917] mb-2">Are the certificates recognized?</h3>
            <p class="text-[#78716C]">Our certificates verify demonstrated skills through hands-on projects. Share them on LinkedIn — employers value what you can do over credentials.</p>
          </div>
          <div class="border-b border-[#E7E5E4] pb-6">
            <h3 class="font-['DM_Sans'] font-bold text-[#1C1917] mb-2">What if I'm not satisfied?</h3>
            <p class="text-[#78716C]">We offer a 7-day money-back guarantee. Try the full course risk-free.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="py-24 bg-[#059669] text-white">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <h2 class="font-['DM_Serif_Display'] text-4xl md:text-5xl mb-6">Ready to Train?</h2>
          <p class="text-lg mb-10 opacity-90">
          Access your course content and start training.
        </p>
        <a href="/login" class="inline-block bg-white text-[#059669] px-12 py-5 font-['DM_Sans'] font-bold uppercase tracking-wider rounded-lg hover:bg-gray-100 transition-colors text-lg">
          Sign In to Start
        </a>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="bg-[#1C1917] text-white py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-4 gap-12 mb-12">
        <div>
          <span class="font-['DM_Sans'] text-lg tracking-widest uppercase">BlueBeltDojo</span>
          <p class="text-[#A8A29E] mt-4 text-sm">Master AI-powered software development through hands-on practice.</p>
        </div>
        <div>
          <h4 class="font-bold uppercase tracking-wider text-sm mb-4">Course</h4>
          <ul class="space-y-2 text-[#A8A29E] text-sm">
            <li><a href="#curriculum" class="hover:text-white transition-colors">Curriculum</a></li>
            <li><a href="#belts" class="hover:text-white transition-colors">Belt System</a></li>
            <li><a href="/login" class="hover:text-white transition-colors">Sign In</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold uppercase tracking-wider text-sm mb-4">Community</h4>
          <ul class="space-y-2 text-[#A8A29E] text-sm">
            <li><a href="/community" class="hover:text-white transition-colors">Discord</a></li>
            <li><a href="/dashboard" class="hover:text-white transition-colors">Dashboard</a></li>
            <li><a href="/login" class="hover:text-white transition-colors">Sign In</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold uppercase tracking-wider text-sm mb-4">Resources</h4>
          <ul class="space-y-2 text-[#A8A29E] text-sm">
            <li><a href="https://github.com/Poom5741/ai-sdlc-course" class="hover:text-white transition-colors">GitHub</a></li>
            <li><a href="#" class="hover:text-white transition-colors">Blog</a></li>
            <li><a href="#" class="hover:text-white transition-colors">Support</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-[#44403C] pt-8 text-center text-[#78716C] text-sm">
        <p>© 2024 BlueBeltDojo. All rights reserved.</p>
      </div>
    </div>
  </footer>
</BaseLayout>
