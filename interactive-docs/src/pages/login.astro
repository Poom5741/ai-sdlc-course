---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Sign In | BlueBeltDojo">
  <div class="min-h-screen bg-[#FAFAF9] flex items-center justify-center px-6">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <a href="/" class="inline-block">
          <span class="font-['DM_Sans'] text-xl tracking-widest uppercase text-[#1C1917]">BlueBeltDojo</span>
        </a>
      </div>
      
      <div class="bg-white border border-[#E7E5E4] p-8 rounded-lg">
        <h1 class="font-['DM_Serif_Display'] text-3xl text-[#1C1917] mb-8 text-center">Sign In</h1>
        
        <form id="login-form" class="space-y-6">
          <div>
            <label class="block text-sm font-medium text-[#57534E] mb-2">Email</label>
            <input type="email" id="email" required
              class="w-full px-4 py-3 border border-[#E7E5E4] rounded-lg focus:ring-2 focus:ring-[#059669] focus:border-transparent outline-none"
              placeholder="you@example.com" />
          </div>
          
          <div>
            <label class="block text-sm font-medium text-[#57534E] mb-2">Password</label>
            <input type="password" id="password" required
              class="w-full px-4 py-3 border border-[#E7E5E4] rounded-lg focus:ring-2 focus:ring-[#059669] focus:border-transparent outline-none"
              placeholder="••••••••" />
          </div>
          
          <button type="submit" id="submit-btn"
            class="w-full bg-[#059669] text-white py-3 px-6 font-['DM_Sans'] font-medium uppercase tracking-wider hover:bg-[#047857] transition-colors disabled:opacity-50">
            Sign In
          </button>
        </form>
        
        <div id="error-msg" class="hidden mt-4 p-3 bg-red-50 text-red-700 text-sm rounded text-center"></div>
        
        <div class="mt-6 text-center">
          <p class="text-[#78716C] text-sm">
            Don't have an account? <a href="/register" class="text-[#059669] hover:underline font-medium">Register</a>
          </p>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Redirect if already logged in
    if (localStorage.getItem('bbd_token')) {
      window.location.href = '/dashboard';
    }

    document.getElementById('login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const email = document.getElementById('email').value;
      const password = document.getElementById('password').value;
      const errorDiv = document.getElementById('error-msg');
      const submitBtn = document.getElementById('submit-btn');
      
      errorDiv.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Signing in...';
      
      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password })
        });
        
        const data = await res.json();
        
        if (!res.ok) {
          errorDiv.textContent = data.error;
          errorDiv.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Sign In';
          return;
        }
        
        localStorage.setItem('bbd_token', data.token);
        localStorage.setItem('bbd_role', data.role || 'user');
        // Redirect admin to admin panel, others to dashboard
        if (data.role === 'admin') {
          window.location.href = '/admin';
        } else {
          window.location.href = '/dashboard';
        }
      } catch (err) {
        errorDiv.textContent = 'Network error. Please try again.';
        errorDiv.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Sign In';
      }
    });
  </script>
</BaseLayout>
