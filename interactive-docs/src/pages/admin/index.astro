---
// Admin Panel for LMS Access Code Management
// Uses unified auth - redirects to /login if not authenticated or not admin
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Admin Panel - AI SDLC Course">
  <main class="min-h-screen bg-gray-50 py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Loading State -->
      <div id="loading-section" class="max-w-md mx-auto text-center py-12">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-trail-green mx-auto"></div>
        <p class="mt-4 text-gray-600">Checking access...</p>
      </div>

      <!-- Access Denied -->
      <div id="denied-section" class="max-w-md mx-auto text-center py-12 hidden">
        <div class="bg-white rounded-2xl shadow-lg p-8">
          <h1 class="text-3xl font-bold text-gray-900 mb-4">🔒 Access Denied</h1>
          <p class="text-gray-600 mb-6">You need admin privileges to access this page.</p>
          <a href="/login" class="inline-block bg-trail-green text-white py-3 px-6 rounded-lg font-semibold hover:bg-trail-green/90 transition-colors">
            Sign In with Admin Account
          </a>
        </div>
      </div>

      <!-- Dashboard (shown when authenticated as admin) -->
      <div id="dashboard-section" class="hidden">
        <!-- Header -->
        <div class="flex justify-between items-center mb-8">
          <div>
            <h1 class="text-3xl font-bold text-gray-900">🔧 Admin Panel</h1>
            <p class="text-gray-600 mt-1">Manage access codes for the workshop</p>
          </div>
          <div class="flex items-center gap-4">
            <span id="admin-email" class="text-sm text-gray-500"></span>
            <a href="/dashboard" class="px-4 py-2 text-trail-green hover:text-trail-green/80 border border-trail-green rounded-lg hover:bg-trail-green/5 transition-colors">
              Dashboard
            </a>
            <button
              id="logout-btn"
              class="px-4 py-2 text-gray-600 hover:text-gray-900 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors"
            >
              Logout
            </button>
          </div>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
          <div class="bg-white rounded-xl shadow-sm p-6">
            <div class="text-sm font-medium text-gray-500 mb-1">Total Codes</div>
            <div id="stat-total" class="text-3xl font-bold text-gray-900">0</div>
          </div>
          <div class="bg-white rounded-xl shadow-sm p-6">
            <div class="text-sm font-medium text-gray-500 mb-1">Used</div>
            <div id="stat-used" class="text-3xl font-bold text-green-600">0</div>
          </div>
          <div class="bg-white rounded-xl shadow-sm p-6">
            <div class="text-sm font-medium text-gray-500 mb-1">Unused</div>
            <div id="stat-unused" class="text-3xl font-bold text-blue-600">0</div>
          </div>
          <div class="bg-white rounded-xl shadow-sm p-6">
            <div class="text-sm font-medium text-gray-500 mb-1">Expired</div>
            <div id="stat-expired" class="text-3xl font-bold text-red-600">0</div>
          </div>
        </div>

        <!-- Create Codes Section -->
        <div class="bg-white rounded-xl shadow-sm p-6 mb-8">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">Create New Codes</h2>
          <form id="create-form" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label for="plan" class="block text-sm font-medium text-gray-700 mb-2">Plan</label>
                <select
                  id="plan"
                  name="plan"
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-trail-green focus:border-trail-green"
                >
                  <option value="workshop-2024">Workshop 2024</option>
                  <option value="workshop-2025">Workshop 2025</option>
                  <option value="premium">Premium</option>
                </select>
              </div>
              <div>
                <label for="count" class="block text-sm font-medium text-gray-700 mb-2">Count</label>
                <input
                  type="number"
                  id="count"
                  name="count"
                  min="1"
                  max="100"
                  value="1"
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-trail-green focus:border-trail-green"
                />
              </div>
              <div>
                <label for="expires" class="block text-sm font-medium text-gray-700 mb-2">Expires</label>
                <input
                  type="date"
                  id="expires"
                  name="expires"
                  value="2025-12-31"
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-trail-green focus:border-trail-green"
                />
              </div>
              <div>
                <label for="batch" class="block text-sm font-medium text-gray-700 mb-2">Batch</label>
                <input
                  type="text"
                  id="batch"
                  name="batch"
                  placeholder="e.g., january-cohort"
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-trail-green focus:border-trail-green"
                />
              </div>
            </div>
            <div>
              <label for="notes" class="block text-sm font-medium text-gray-700 mb-2">Notes</label>
              <textarea
                id="notes"
                name="notes"
                rows="2"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-trail-green focus:border-trail-green"
                placeholder="Optional notes about this batch"
              ></textarea>
            </div>
            <button
              type="submit"
              id="create-btn"
              class="bg-trail-green text-white py-2 px-6 rounded-lg font-semibold hover:bg-trail-green/90 transition-colors"
            >
              Generate Codes
            </button>
          </form>

          <!-- Created Codes Display -->
          <div id="created-codes" class="hidden mt-6 p-4 bg-green-50 rounded-lg border border-green-200">
            <h3 class="text-sm font-medium text-green-800 mb-2">✅ Codes Created Successfully</h3>
            <div id="codes-list" class="font-mono text-sm text-green-700 space-y-1"></div>
            <button
              id="copy-codes-btn"
              class="mt-4 text-sm text-green-600 hover:text-green-800 underline"
            >
              Copy all codes
            </button>
          </div>
        </div>

        <!-- Code List Section -->
        <div class="bg-white rounded-xl shadow-sm p-6">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4 gap-4">
            <h2 class="text-xl font-semibold text-gray-900">All Codes</h2>
            <div class="flex gap-2">
              <select
                id="filter-status"
                class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-trail-green focus:border-trail-green"
              >
                <option value="all">All Status</option>
                <option value="unused">Unused</option>
                <option value="used">Used</option>
                <option value="expired">Expired</option>
              </select>
              <input
                type="text"
                id="filter-search"
                placeholder="Search codes..."
                class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-trail-green focus:border-trail-green"
              />
            </div>
          </div>

          <!-- Codes Table -->
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="border-b border-gray-200">
                  <th class="text-left py-3 px-4 text-sm font-medium text-gray-500">Code</th>
                  <th class="text-left py-3 px-4 text-sm font-medium text-gray-500">Status</th>
                  <th class="text-left py-3 px-4 text-sm font-medium text-gray-500">Created</th>
                  <th class="text-left py-3 px-4 text-sm font-medium text-gray-500">Used At</th>
                  <th class="text-left py-3 px-4 text-sm font-medium text-gray-500">Plan</th>
                  <th class="text-left py-3 px-4 text-sm font-medium text-gray-500">Actions</th>
                </tr>
              </thead>
              <tbody id="codes-tbody" class="divide-y divide-gray-100">
                <!-- Codes will be loaded here -->
              </tbody>
            </table>
          </div>

          <!-- Pagination -->
          <div id="pagination" class="flex items-center justify-between mt-4 pt-4 border-t border-gray-200">
            <div class="text-sm text-gray-500">
              Showing <span id="showing-start">0</span> to <span id="showing-end">0</span> of <span id="showing-total">0</span> codes
            </div>
            <div class="flex gap-2">
              <button
                id="prev-page"
                class="px-3 py-1 text-sm border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed"
              >
                Previous
              </button>
              <button
                id="next-page"
                class="px-3 py-1 text-sm border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed"
              >
                Next
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  // Admin Panel Logic - Uses unified auth (bbd_token)
  let authToken: string | null = null;
  let currentPage = 1;
  const pageSize = 20;

  // DOM Elements
  const loadingSection = document.getElementById('loading-section');
  const deniedSection = document.getElementById('denied-section');
  const dashboardSection = document.getElementById('dashboard-section');
  const adminEmail = document.getElementById('admin-email');
  const logoutBtn = document.getElementById('logout-btn');
  const createForm = document.getElementById('create-form') as HTMLFormElement;
  const createdCodes = document.getElementById('created-codes');
  const codesList = document.getElementById('codes-list');
  const copyCodesBtn = document.getElementById('copy-codes-btn');
  const codesTbody = document.getElementById('codes-tbody');
  const filterStatus = document.getElementById('filter-status') as HTMLSelectElement;
  const filterSearch = document.getElementById('filter-search') as HTMLInputElement;
  const prevPageBtn = document.getElementById('prev-page') as HTMLButtonElement | null;
  const nextPageBtn = document.getElementById('next-page') as HTMLButtonElement | null;

  // Check auth and verify admin role
  async function checkAuth(): Promise<boolean> {
    const token = localStorage.getItem('bbd_token');
    if (!token) return false;

    try {
      const res = await fetch('/api/auth/me', {
        headers: { 'Authorization': `Bearer ${token}` }
      });

      if (!res.ok) {
        localStorage.removeItem('bbd_token');
        localStorage.removeItem('bbd_role');
        return false;
      }

      const data = await res.json();
      
      // Check if user is admin
      if (data.role !== 'admin') {
        return false;
      }

      authToken = token;
      adminEmail!.textContent = data.email;
      return true;
    } catch {
      return false;
    }
  }

  // Show appropriate section
  async function init(): Promise<void> {
    const isAdmin = await checkAuth();
    
    loadingSection?.classList.add('hidden');
    
    if (isAdmin) {
      dashboardSection?.classList.remove('hidden');
      loadStats();
      loadCodes();
    } else {
      deniedSection?.classList.remove('hidden');
    }
  }

  // Logout
  function logout(): void {
    authToken = null;
    localStorage.removeItem('bbd_token');
    localStorage.removeItem('bbd_role');
    window.location.href = '/login';
  }

  // Load stats
  async function loadStats(): Promise<void> {
    try {
      const response = await fetch('/api/admin/codes?limit=1000', {
        headers: { 'Authorization': `Bearer ${authToken}` }
      });
      const data = await response.json();
      
      const codes = data.codes || [];
      const total = codes.length;
      const used = codes.filter((c: any) => c.used).length;
      const expired = codes.filter((c: any) => c.expires && new Date(c.expires) < new Date()).length;
      const unused = total - used - expired;

      document.getElementById('stat-total')!.textContent = total.toString();
      document.getElementById('stat-used')!.textContent = used.toString();
      document.getElementById('stat-unused')!.textContent = unused.toString();
      document.getElementById('stat-expired')!.textContent = expired.toString();
    } catch (error) {
      console.error('Failed to load stats:', error);
    }
  }

  // Load codes
  async function loadCodes(): Promise<void> {
    try {
      const status = filterStatus.value;
      const search = filterSearch.value;
      
      let url = `/api/admin/codes?page=${currentPage}&limit=${pageSize}`;
      if (status !== 'all') url += `&status=${status}`;
      
      const response = await fetch(url, {
        headers: { 'Authorization': `Bearer ${authToken}` }
      });
      const data = await response.json();
      
      let codes = data.codes || [];
      
      // Client-side search filter
      if (search) {
        codes = codes.filter((c: any) => 
          c.code.toLowerCase().includes(search.toLowerCase())
        );
      }

      renderCodes(codes);
      updatePagination(data.pagination);
    } catch (error) {
      console.error('Failed to load codes:', error);
    }
  }

  // Render codes table
  function renderCodes(codes: any[]): void {
    if (!codesTbody) return;

    if (codes.length === 0) {
      codesTbody.innerHTML = `
        <tr>
          <td colspan="6" class="py-8 text-center text-gray-500">
            No codes found
          </td>
        </tr>
      `;
      return;
    }

    codesTbody.innerHTML = codes.map(code => {
      const status = code.revoked ? 'revoked' : 
                     code.used ? 'used' : 
                     (code.expires && new Date(code.expires) < new Date()) ? 'expired' : 'unused';
      
      const statusBadge: Record<string, string> = {
        unused: '<span class="px-2 py-1 text-xs font-medium bg-blue-100 text-blue-800 rounded-full">Unused</span>',
        used: '<span class="px-2 py-1 text-xs font-medium bg-green-100 text-green-800 rounded-full">Used</span>',
        expired: '<span class="px-2 py-1 text-xs font-medium bg-red-100 text-red-800 rounded-full">Expired</span>',
        revoked: '<span class="px-2 py-1 text-xs font-medium bg-gray-100 text-gray-800 rounded-full">Revoked</span>'
      }[status];

      return `
        <tr class="hover:bg-gray-50">
          <td class="py-3 px-4 font-mono text-sm">${code.code}</td>
          <td class="py-3 px-4">${statusBadge}</td>
          <td class="py-3 px-4 text-sm text-gray-500">${new Date(code.created).toLocaleDateString()}</td>
          <td class="py-3 px-4 text-sm text-gray-500">${code.usedAt ? new Date(code.usedAt).toLocaleDateString() : '-'}</td>
          <td class="py-3 px-4 text-sm text-gray-500">${code.plan}</td>
          <td class="py-3 px-4">
            ${!code.revoked ? `
              <button 
                onclick="revokeCode('${code.code}')"
                class="text-red-600 hover:text-red-800 text-sm"
              >
                Revoke
              </button>
            ` : ''}
          </td>
        </tr>
      `;
    }).join('');
  }

  // Update pagination
  function updatePagination(pagination: any): void {
    if (!pagination) return;

    const start = (pagination.page - 1) * pagination.limit + 1;
    const end = Math.min(pagination.page * pagination.limit, pagination.total);

    document.getElementById('showing-start')!.textContent = start.toString();
    document.getElementById('showing-end')!.textContent = end.toString();
    document.getElementById('showing-total')!.textContent = pagination.total.toString();

    if (prevPageBtn) prevPageBtn.disabled = pagination.page <= 1;
    if (nextPageBtn) nextPageBtn.disabled = pagination.page >= pagination.pages;
  }

  // Create codes
  async function createCodes(formData: FormData): Promise<void> {
    try {
      const body = {
        plan: formData.get('plan'),
        count: parseInt(formData.get('count') as string),
        expires: new Date(formData.get('expires') as string).toISOString(),
        batch: formData.get('batch') || undefined,
        metadata: {
          notes: formData.get('notes') || undefined
        }
      };

      const response = await fetch('/api/admin/codes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${authToken}` },
        body: JSON.stringify(body)
      });

      const result = await response.json();

      if (response.ok) {
        // Show created codes
        codesList!.innerHTML = result.created.join('<br>');
        createdCodes!.classList.remove('hidden');
        
        // Refresh stats and list
        loadStats();
        loadCodes();
      } else {
        alert(result.error || 'Failed to create codes');
      }
    } catch (error) {
      alert('Network error. Please try again.');
    }
  }

  // Revoke code
  async function revokeCode(code: string): Promise<void> {
    if (!confirm(`Are you sure you want to revoke ${code}?`)) return;

    try {
      const response = await fetch(`/api/admin/codes?code=${code}`, {
        method: 'DELETE',
        headers: { 'Authorization': `Bearer ${authToken}` }
      });

      if (response.ok) {
        loadStats();
        loadCodes();
      } else {
        const result = await response.json();
        alert(result.error || 'Failed to revoke code');
      }
    } catch (error) {
      alert('Network error. Please try again.');
    }
  }

  // Make revokeCode available globally
  (window as any).revokeCode = revokeCode;

  // Event Listeners
  logoutBtn?.addEventListener('click', logout);

  createForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(createForm);
    await createCodes(formData);
  });

  copyCodesBtn?.addEventListener('click', () => {
    const codes = codesList!.innerText;
    navigator.clipboard.writeText(codes);
    copyCodesBtn!.textContent = 'Copied!';
    setTimeout(() => {
      copyCodesBtn!.textContent = 'Copy all codes';
    }, 2000);
  });

  filterStatus?.addEventListener('change', () => {
    currentPage = 1;
    loadCodes();
  });

  filterSearch?.addEventListener('input', () => {
    currentPage = 1;
    loadCodes();
  });

  prevPageBtn?.addEventListener('click', () => {
    if (currentPage > 1) {
      currentPage--;
      loadCodes();
    }
  });

  nextPageBtn?.addEventListener('click', () => {
    currentPage++;
    loadCodes();
  });

  // Initialize
  init();
</script>
