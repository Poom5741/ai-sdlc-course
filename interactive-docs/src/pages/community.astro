---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Community | BlueBeltDojo">
  <div class="min-h-screen bg-[#FAFAF9] pt-24 pb-16">
    <div class="max-w-4xl mx-auto px-6">
      
      <!-- Header -->
      <div class="text-center mb-16">
        <span class="text-sm uppercase tracking-[0.3em] text-[#D97706] mb-4 block">Join the Community</span>
        <h1 class="font-['DM_Serif_Display'] text-5xl text-[#1C1917] mb-6">Train Together</h1>
        <p class="text-xl text-[#78716C] max-w-2xl mx-auto">
          Connect with fellow learners, get help when stuck, share your progress, and grow together.
        </p>
      </div>

      <!-- Discord CTA -->
      <div class="bg-[#5865F2] text-white rounded-2xl p-8 md:p-12 mb-16 text-center">
        <div class="flex items-center justify-center gap-4 mb-6">
          <svg class="w-12 h-12" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
          </svg>
          <h2 class="font-['DM_Serif_Display'] text-4xl">Discord Community</h2>
        </div>
        <p class="text-lg mb-8 opacity-90">
          Join 500+ learners mastering AI-powered development together
        </p>
        <div id="discord-actions">
          <a id="discord-link" href="#" 
            class="inline-block bg-white text-[#5865F2] px-8 py-4 rounded-lg font-['DM_Sans'] font-bold uppercase tracking-wider hover:bg-gray-100 transition-colors">
            Join Discord Server
          </a>
        </div>
        <p id="discord-status" class="text-sm mt-4 opacity-75"></p>
      </div>

      <!-- Channel Guide -->
      <div class="mb-16">
        <h2 class="font-['DM_Serif_Display'] text-3xl text-[#1C1917] mb-8 text-center">Channel Guide</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white border border-[#E7E5E4] p-6 rounded-lg">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-2xl">📚</span>
              <h3 class="font-['DM_Sans'] font-bold text-[#1C1917]">#quest-help</h3>
            </div>
            <p class="text-[#78716C] text-sm">Stuck on a quest? Ask here. Include what you've tried and any error messages.</p>
          </div>
          <div class="bg-white border border-[#E7E5E4] p-6 rounded-lg">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-2xl">🎉</span>
              <h3 class="font-['DM_Sans'] font-bold text-[#1C1917]">#showcase</h3>
            </div>
            <p class="text-[#78716C] text-sm">Share completed quests, capstone projects, and cool things you've built.</p>
          </div>
          <div class="bg-white border border-[#E7E5E4] p-6 rounded-lg">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-2xl">👀</span>
              <h3 class="font-['DM_Sans'] font-bold text-[#1C1917]">#peer-review</h3>
            </div>
            <p class="text-[#78716C] text-sm">Get feedback on your capstone projects before submission.</p>
          </div>
          <div class="bg-white border border-[#E7E5E4] p-6 rounded-lg">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-2xl">💬</span>
              <h3 class="font-['DM_Sans'] font-bold text-[#1C1917]">#general</h3>
            </div>
            <p class="text-[#78716C] text-sm">Chat about AI tools, techniques, and the industry in general.</p>
          </div>
        </div>
      </div>

      <!-- Belt-Based Access -->
      <div class="mb-16">
        <h2 class="font-['DM_Serif_Display'] text-3xl text-[#1C1917] mb-8 text-center">Belt Channels</h2>
        <p class="text-center text-[#78716C] mb-8">
          As you progress, you'll unlock access to belt-specific channels with advanced content.
        </p>
        <div class="space-y-4">
          <div class="flex items-center gap-4 bg-white border border-[#E7E5E4] p-4 rounded-lg">
            <div class="w-10 h-10 rounded-full bg-white border-2 border-[#E7E5E4]"></div>
            <div>
              <h3 class="font-['DM_Sans'] font-bold text-[#1C1917]">#white-belt</h3>
              <p class="text-sm text-[#78716C]">All learners • Getting started resources</p>
            </div>
          </div>
          <div class="flex items-center gap-4 bg-white border border-[#E7E5E4] p-4 rounded-lg">
            <div class="w-10 h-10 rounded-full bg-[#2563EB]"></div>
            <div>
              <h3 class="font-['DM_Sans'] font-bold text-[#1C1917]">#blue-belt</h3>
              <p class="text-sm text-[#78716C]">20+ quests completed • Advanced topics</p>
            </div>
          </div>
          <div class="flex items-center gap-4 bg-white border border-[#E7E5E4] p-4 rounded-lg">
            <div class="w-10 h-10 rounded-full bg-[#9333EA]"></div>
            <div>
              <h3 class="font-['DM_Sans'] font-bold text-[#1C1917]">#purple-belt</h3>
              <p class="text-sm text-[#78716C]">50+ quests completed • Production patterns</p>
            </div>
          </div>
          <div class="flex items-center gap-4 bg-white border border-[#E7E5E4] p-4 rounded-lg">
            <div class="w-10 h-10 rounded-full bg-[#92400E]"></div>
            <div>
              <h3 class="font-['DM_Sans'] font-bold text-[#1C1917]">#brown-belt</h3>
              <p class="text-sm text-[#78716C]">90+ quests completed • Architecture discussions</p>
            </div>
          </div>
          <div class="flex items-center gap-4 bg-white border border-[#E7E5E4] p-4 rounded-lg">
            <div class="w-10 h-10 rounded-full bg-[#1C1917]"></div>
            <div>
              <h3 class="font-['DM_Sans'] font-bold text-[#1C1917]">#black-belt</h3>
              <p class="text-sm text-[#78716C]">118+ quests completed • Mentorship opportunities</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Guidelines -->
      <div class="bg-white border border-[#E7E5E4] p-8 rounded-lg">
        <h2 class="font-['DM_Serif_Display'] text-3xl text-[#1C1917] mb-6">Community Guidelines</h2>
        <div class="space-y-4 text-[#57534E]">
          <div class="flex gap-4">
            <span class="text-[#059669] font-bold">01</span>
            <p><strong>Be respectful.</strong> Everyone is here to learn. Treat others as you'd want to be treated.</p>
          </div>
          <div class="flex gap-4">
            <span class="text-[#059669] font-bold">02</span>
            <p><strong>Help others learn.</strong> When answering questions, explain the "why" not just the "how".</p>
          </div>
          <div class="flex gap-4">
            <span class="text-[#059669] font-bold">03</span>
            <p><strong>No spoilers for quests.</strong> Share hints, not complete solutions. Let others experience the learning.</p>
          </div>
          <div class="flex gap-4">
            <span class="text-[#059669] font-bold">04</span>
            <p><strong>Share your wins.</strong> Completed a quest? Finished a capstone? Celebrate with the community!</p>
          </div>
          <div class="flex gap-4">
            <span class="text-[#059669] font-bold">05</span>
            <p><strong>Stay on topic.</strong> Keep discussions related to AI-powered software development.</p>
          </div>
        </div>
      </div>

    </div>
  </div>

  <script>
    const DISCORD_INVITE = 'https://discord.gg/bluebeltdojo';
    let authToken = localStorage.getItem('bbd_token');

    async function initDiscordLink() {
      const linkEl = document.getElementById('discord-link');
      const statusEl = document.getElementById('discord-status');
      
      if (authToken) {
        try {
          const res = await fetch('/api/auth/me', {
            headers: { 'Authorization': `Bearer ${authToken}` }
          });
          
          if (res.ok) {
            linkEl.href = '/api/discord/link';
            linkEl.onclick = (e) => {
              e.preventDefault();
              window.open('/api/discord/link', 'discord-oauth', 'width=500,height=700');
            };
            statusEl.textContent = 'Click to link your Discord account';
          } else {
            linkEl.href = DISCORD_INVITE;
            statusEl.textContent = 'Sign in to link your account for belt roles';
          }
        } catch (e) {
          linkEl.href = DISCORD_INVITE;
        }
      } else {
        linkEl.href = DISCORD_INVITE;
        statusEl.textContent = 'Sign in to link your account for belt roles';
      }
    }

    // Listen for Discord OAuth callback
    window.addEventListener('message', (e) => {
      if (e.data?.success) {
        document.getElementById('discord-status').textContent = 
          `✓ Linked as ${e.data.username}`;
      } else if (e.data?.error) {
        document.getElementById('discord-status').textContent = 
          `Error: ${e.data.error}`;
      }
    });

    initDiscordLink();
  </script>
</BaseLayout>
